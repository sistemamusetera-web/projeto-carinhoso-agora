{
  "manifest_version": 3,
  "name": "Agente de Evolução Terapêutica",
  "version": "0.2.7",
  "description": "Gera evoluções terapêuticas com IA dentro do Clínica nas Nuvens.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://app.clinicanasnuvens.com.br/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_title": "Agente de Evolução — abrir chat"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.clinicanasnuvens.com.br/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
